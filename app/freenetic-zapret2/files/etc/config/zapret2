# Schema v2 is the public OpenWrt configuration contract. It follows nfqws2's
# native ordered profile and in-profile step model and is intentionally
# incompatible with every earlier wrapper schema.
config zapret2 'main'
	option schema_version '2'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '1'
	list wan_network 'wan'
	list source_network 'lan'
	option process_forwarded '1'
	option process_local '0'
	option intercept_mode 'all'
	# Retained only so upgrades from earlier releases preserve this conffile.
	# The current control plane ignores this legacy option.
	option all_traffic_ack '0'
	# list include_mark '0x10000000/0x10000000'
	# list exclude_mark '0x08000000/0x08000000'
	option connection_mark '0x20000000'
	option generated_mark '0x40000000'
	option queue_num '200'
	option tcp_out_packets '20'
	option tcp_in_packets '10'
	option udp_out_packets '5'
	option udp_in_packets '3'
	option other_out_packets '5'
	option other_in_packets '3'
	option debug_mode 'off'
	option bind_fix4 '0'
	option bind_fix6 '0'
	option ipcache_hostname '0'
	option ipcache_lifetime '7200'
	option ctrack_disable '0'
	option ctrack_syn_timeout '60'
	option ctrack_established_timeout '300'
	option ctrack_fin_timeout '60'
	option ctrack_udp_timeout '60'
	option lua_gc_interval '300'

config profile 'http_default'
	option id 'http_default'
	option name 'HTTP conservative'
	option enabled '1'
	option order '10'
	option family 'dual'
	option queue_mode 'initial'
	list tcp_port '80'
	list l7 'http'

config step 'http_payload'
	option id 'http_payload'
	option profile 'http_default'
	option order '10'
	option type 'payload'
	list value 'http_req'

config step 'http_split'
	option id 'http_split'
	option profile 'http_default'
	option order '20'
	option type 'multisplit'
	option position '1'

config profile 'tls_default'
	option id 'tls_default'
	option name 'TLS conservative'
	option enabled '1'
	option order '20'
	option family 'dual'
	option queue_mode 'initial'
	list tcp_port '443'
	list l7 'tls'

config step 'tls_payload'
	option id 'tls_payload'
	option profile 'tls_default'
	option order '10'
	option type 'payload'
	list value 'tls_client_hello'

config step 'tls_split'
	option id 'tls_split'
	option profile 'tls_default'
	option order '20'
	option type 'multisplit'
	option position '1'

config profile 'quic_default'
	option id 'quic_default'
	option name 'QUIC standard'
	option enabled '0'
	option order '30'
	option family 'dual'
	option queue_mode 'initial'
	list udp_port '443'
	list l7 'quic'

config step 'quic_payload'
	option id 'quic_payload'
	option profile 'quic_default'
	option order '10'
	option type 'payload'
	list value 'quic_initial'

config step 'quic_fake'
	option id 'quic_fake'
	option profile 'quic_default'
	option order '20'
	option type 'fake'
	option blob 'fake_default_quic'
	option repeats '6'
