# Applications
msgid "Recommended"
msgstr "Рекомендуемые"

msgid "Advanced networking"
msgstr "Расширенная сеть"

msgid "All"
msgstr "Все"

msgid "Application filters"
msgstr "Фильтры приложений"

msgid "Advanced networking tools"
msgstr "Расширенные сетевые инструменты"

msgid "VPN clients"
msgstr "VPN-клиенты"

msgid "WireGuard VPN"
msgstr "VPN WireGuard"

msgid "Modern, fast VPN client built into the Linux kernel, with native LuCI support."
msgstr "Современный быстрый VPN-клиент на основе ядра Linux с поддержкой LuCI."

msgid "PPTP client"
msgstr "Клиент PPTP"

msgid "Connect to a PPTP VPN server."
msgstr "Подключение к VPN-серверу PPTP."

msgid "L2TP client"
msgstr "Клиент L2TP"

msgid "Connect to an L2TP VPN server."
msgstr "Подключение к VPN-серверу L2TP."

msgid "L2TP/IPsec client"
msgstr "Клиент L2TP/IPsec"

msgid "L2TP over an IPsec-encrypted tunnel."
msgstr "L2TP поверх туннеля с шифрованием IPsec."

msgid "OpenVPN client and server"
msgstr "Клиент и сервер OpenVPN"

msgid "Widely supported, certificate-based VPN."
msgstr "Распространённый VPN на основе сертификатов."

msgid "UPnP service"
msgstr "Сервис UPnP"

msgid "Lets apps and game consoles open ports automatically."
msgstr "Позволяет приложениям и игровым консолям автоматически открывать порты."

msgid "DDNS client"
msgstr "Клиент DDNS"

msgid "Keeps a hostname pointed at this router's changing address."
msgstr "Поддерживает имя хоста, указывающее на меняющийся адрес роутера."

msgid "mDNS service"
msgstr "Сервис mDNS"

msgid "Local device/service discovery (Bonjour/Zeroconf)."
msgstr "Обнаружение устройств и сервисов в локальной сети (Bonjour/Zeroconf)."

msgid "SNMP server"
msgstr "SNMP-сервер"

msgid "Exposes router metrics to monitoring software."
msgstr "Предоставляет метрики роутера системам мониторинга."

msgid "Security and DNS"
msgstr "Безопасность и DNS"

msgid "DNS-over-HTTPS proxy"
msgstr "Прокси DNS-over-HTTPS"

msgid "Encrypts outgoing DNS lookups."
msgstr "Шифрует исходящие DNS-запросы."

msgid "Ad blocking (Adblock)"
msgstr "Блокировка рекламы (Adblock)"

msgid "Blocks ads and trackers for the whole network via DNS."
msgstr "Блокирует рекламу и трекеры во всей сети через DNS."

msgid "Files and media"
msgstr "Файлы и мультимедиа"

msgid "File server (Samba)"
msgstr "Файловый сервер (Samba)"

msgid "Share a USB drive as a network folder."
msgstr "Открывает USB-накопитель как сетевую папку."

msgid "DLNA server"
msgstr "DLNA-сервер"

msgid "Streams media from a USB drive to TVs and players."
msgstr "Передаёт мультимедиа с USB-накопителя на телевизоры и проигрыватели."

msgid "USB storage"
msgstr "USB-накопители"

msgid "USB storage support"
msgstr "Поддержка USB-накопителей"

msgid "Mount USB drives and inspect connected storage devices."
msgstr "Подключает USB-накопители и показывает подключённые устройства хранения."

msgid "Common USB filesystems"
msgstr "Распространённые файловые системы USB"

msgid "Read common Linux, Windows and removable-drive filesystems."
msgstr "Читает распространённые файловые системы Linux, Windows и съёмных дисков."

msgid "USB peripherals"
msgstr "USB-периферия"

msgid "USB printer server"
msgstr "Сервер USB-принтера"

msgid "Share a USB printer with devices on the local network."
msgstr "Открывает USB-принтер для устройств в локальной сети."

msgid "USB UPS monitoring"
msgstr "Мониторинг USB-ИБП"

msgid "Monitor a UPS connected to the router over USB."
msgstr "Контролирует ИБП, подключённый к роутеру по USB."

msgid "USB modems"
msgstr "USB-модемы"

msgid "LTE/5G modem (QMI)"
msgstr "LTE/5G-модем (QMI)"

msgid "Connect cellular modems that expose a Qualcomm QMI network interface."
msgstr "Подключает сотовые модемы с сетевым интерфейсом Qualcomm QMI."

msgid "LTE/5G modem (MBIM)"
msgstr "LTE/5G-модем (MBIM)"

msgid "Connect LTE/5G modems that expose a standards-based MBIM interface."
msgstr "Подключает LTE/5G-модемы со стандартным интерфейсом MBIM."

msgid "Legacy 3G/4G modem (PPP)"
msgstr "Устаревший 3G/4G-модем (PPP)"

msgid "Support older USB modems through serial ports or PPP."
msgstr "Поддерживает старые USB-модемы через последовательный порт или PPP."

msgid "Automatic modem management"
msgstr "Автоматическое управление модемами"

msgid "Detect and manage supported cellular modems through ModemManager."
msgstr "Обнаруживает и управляет поддерживаемыми модемами через ModemManager."

msgid "USB tethering"
msgstr "USB-модем через телефон"

msgid "Use an Android phone or another USB network device as an uplink."
msgstr "Использует Android-телефон или другое USB-сетевое устройство как канал связи."

msgid "Policy-based routing"
msgstr "Маршрутизация по политикам"

msgid "Route a network segment through a selected WAN or VPN tunnel."
msgstr "Направляет сегмент сети через выбранный WAN или VPN-туннель."

msgid "Zapret"
msgstr "Zapret"

msgid "Advanced traffic-processing tool for regional connectivity scenarios."
msgstr "Расширенный инструмент обработки трафика для особых сценариев подключения."

msgid "MagiTrickle"
msgstr "MagiTrickle"

msgid "Specialized traffic-routing and filtering tool for experienced users."
msgstr "Специализированный инструмент маршрутизации и фильтрации трафика для опытных пользователей."

msgid "Install additional features on demand. Recommended features are suitable for most routers; Advanced networking tools can change traffic processing and are intended for experienced users. Packages come from the router's configured repositories."
msgstr "Устанавливайте дополнительные функции по необходимости. Рекомендуемые функции подходят большинству роутеров, а расширенные сетевые инструменты могут менять обработку трафика и предназначены для опытных пользователей. Пакеты загружаются из настроенных репозиториев роутера."

msgid "No applications are installed yet."
msgstr "Приложения пока не установлены."

msgid "No advanced networking tools are available in the current catalog."
msgstr "В текущем каталоге нет расширенных сетевых инструментов."

msgid "No applications are available in the current catalog."
msgstr "В текущем каталоге нет доступных приложений."

msgid "Not installed"
msgstr "Не установлено"

