msgstr "L2TP/IPsec"

msgid "IKEv2/IPsec"
msgstr "IKEv2/IPsec"

msgid "Legacy PPP tunnel protected by an IPsec transport connection."
msgstr "Устаревший PPP-туннель, защищённый транспортным соединением IPsec."

msgid "xl2tpd and strongSwan are ready."
msgstr "xl2tpd и strongSwan готовы."

msgid "Modern IPsec VPN with PSK or EAP-MSCHAPv2 authentication."
msgstr "Современный IPsec VPN с аутентификацией PSK или EAP-MSCHAPv2."

msgid "strongSwan and the XFRM interface are ready."
msgstr "strongSwan и интерфейс XFRM готовы."

msgid "Interface ready"
msgstr "Интерфейс готов"

msgid "Server"
msgstr "Сервер"

msgid "PPP username"
msgstr "Имя пользователя PPP"

msgid "IP version"
msgstr "Версия IP"

msgid "IPv4 + IPv6"
msgstr "IPv4 + IPv6"

msgid "Authentication"
msgstr "Аутентификация"

msgid "EAP-MSCHAPv2"
msgstr "EAP-MSCHAPv2"

msgid "Pre-shared key"
msgstr "Предварительно согласованный ключ"

msgid "XFRM interface ID"
msgstr "ID интерфейса XFRM"

