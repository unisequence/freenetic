#!/bin/sh
# Return compact availability information for a finite package list.
#
# The package manager's complete "list-available" response is deliberately
# not used here: on a normal OpenWrt snapshot it can be several megabytes of
# JSON.  Freenetic pages only need to know whether their small set of concrete
# packages can be resolved on this firmware.

json_escape() {
	# Package names passed by Freenetic are deliberately conservative.  Keep
	# this escape helper anyway so the output remains valid JSON if another
	# caller supplies a legal-but-unusual package name in the future.
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_package_name() {
	case "$1" in
		''|-*|*[!A-Za-z0-9+_.:@/-]*) return 1 ;;
		*) return 0 ;;
	esac
}

if [ "$#" -eq 0 ]; then
	printf '{"ok":true,"packages":{}}\n'
	exit 0
fi

# Validate every browser-supplied name before invoking either package
# manager. Apart from rejecting shell metacharacters, the leading-dash guard
# prevents a package name from becoming an apk/opkg option.
for package in "$@"; do
	if ! valid_package_name "$package"; then
		printf '{"ok":false,"error":"Invalid package name."}\n'
		exit 0
	fi
done

manager=''
if command -v apk >/dev/null 2>&1; then
	manager='apk'
elif command -v opkg >/dev/null 2>&1; then
	manager='opkg'
else
	printf '{"ok":false,"error":"No supported package manager was found."}\n'
	exit 0
fi

# One index lookup and one installed-package lookup for all requested names.
# Reopening apk's database once per catalog entry is noticeably slow on a
# router and makes an already completed installation look unfinished.
available=''
installed_packages=''
if [ "$manager" = 'apk' ]; then
	available=$(apk search -e "$@" 2>/dev/null || true)
	installed_packages=$(apk info 2>/dev/null || true)
else
	# opkg accepts one optional pattern, unlike apk's multi-pattern search.
	# Read its plain-text catalogue once so every requested name is checked.
	available=$(opkg list 2>/dev/null || true)
fi

printf '{"ok":true,"package_manager":"%s","packages":{' "$manager"
first=1
for package in "$@"; do
	valid_package_name "$package" || continue

	installed=false
	if [ "$manager" = 'apk' ]; then
		printf '%s\n' "$installed_packages" | grep -Fxq -- "$package" && installed=true
	else
		opkg status "$package" 2>/dev/null |
			awk '$1 == "Status:" && $NF == "installed" { found = 1 } END { exit !found }' && installed=true
	fi

	available_flag=false
	if [ "$manager" = 'apk' ]; then
		# `apk search -e name` prints name-version. Match from the start:
		# luci-app-nut must not make the separate nut package look available.
		printf '%s\n' "$available" |
			awk -v prefix="$package-" 'index($0, prefix) == 1 { found = 1 } END { exit !found }' && available_flag=true
	else
		printf '%s\n' "$available" | awk -v p="$package" '$1 == p { found = 1 } END { exit !found }' && available_flag=true
	fi

	[ "$first" -eq 1 ] || printf ','
	first=0
	printf '"%s":{"installed":%s,"available":%s}' \
		"$(json_escape "$package")" "$installed" "$available_flag"
done
printf '}}\n'
