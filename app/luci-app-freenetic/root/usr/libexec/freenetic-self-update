#!/bin/sh
# Install a pinned Freenetic release selected by the LuCI dashboard.
# The browser supplies only a release tag; repository and asset URLs stay
# fixed here, while the release installer verifies every downloaded asset.
# Do not enable nounset: OpenWrt 24.10's jshn.sh intentionally expands a few
# optional variables before json_init() has created them.

JSHN=/usr/share/libubox/jshn.sh
RAW_BASE_URL=https://raw.githubusercontent.com/unisequence/freenetic
RELEASES_BASE_URL=https://github.com/unisequence/freenetic/releases/download
GITHUB_API_BASE_URL=https://api.github.com/repos/unisequence/freenetic
MAX_INSTALLER_BYTES=262144

if [ ! -r "$JSHN" ]; then
	printf '%s\n' '{"ok":false,"error":"JSON support is unavailable"}'
	exit 0
fi
# shellcheck disable=SC1090
. "$JSHN"

reply_error() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$*"
	json_dump
}

reply_update_error() {
	update_stage="$1"
	rollback_attempted="$2"
	rollback_ok="$3"
	update_error="$4"
	json_init
	json_add_boolean ok 0
	json_add_string stage "$update_stage"
	json_add_boolean rollback_attempted "$rollback_attempted"
	json_add_boolean rollback_ok "$rollback_ok"
	json_add_string error "$update_error"
	json_dump
}

valid_tag() {
	printf '%s\n' "$1" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?$'
}

last_installer_stage() {
	last_stage="$(sed -n 's/^Freenetic installer: stage: //p' "$1" 2>/dev/null | tail -n 1 || true)"
	[ -n "$last_stage" ] || last_stage=install
	printf '%s\n' "$last_stage"
}

rollback_required() {
	case "$1" in
		preflight|download|manifest|package_verification)
			return 1
			;;
		*)
			return 0
			;;
	esac
}

download_installer() {
	installer_tag="$1"
	installer_destination="$2"
	# Some OpenWrt routers advertise an IPv6 resolver/route but do not have
	# working IPv6 egress. BusyBox wget can then fail on the first connection
	# without retrying the same URL over IPv4. Prefer IPv4 for GitHub assets;
	# keep the normal invocation as a fallback for IPv6-only installations and
	# older wget builds which do not implement -4.
	download_release_asset() {
		asset_url="$1"
		asset_destination="$2"
		if wget -4 -qO "$asset_destination" "$asset_url" ||
			wget -qO "$asset_destination" "$asset_url"; then
			return 0
		fi

		# A few networks allow api.github.com and the release CDN but block the
		# github.com redirect endpoint. Resolve the generated installer through
		# the GitHub Releases API in that case; the API's octet-stream response
		# redirects directly to release-assets.githubusercontent.com.
		case "$asset_url" in
			"$RELEASES_BASE_URL"/*/install.sh)
				asset_path="${asset_url#"$RELEASES_BASE_URL/"}"
				asset_tag="${asset_path%/install.sh}"
				[ -n "$asset_tag" ] || return 1
				release_json="$(wget -4 -qO- "$GITHUB_API_BASE_URL/releases/tags/$asset_tag" 2>/dev/null || true)"
				asset_id="$(printf '%s\n' "$release_json" |
					jsonfilter -e '@.assets[@.name="install.sh"].id' 2>/dev/null |
					sed -n '1p')"
				case "$asset_id" in
					''|*[!0-9]*) return 1 ;;
				esac
				wget -4 --header='Accept: application/octet-stream' -qO "$asset_destination" \
					"$GITHUB_API_BASE_URL/releases/assets/$asset_id"
				;;
			*)
				return 1
				;;
		esac
	}
	# New releases publish a generated installer beside their packages so its
	# pinned hashes always match the final release assets. A raw-tag fallback is
	# allowed only for the historical releases which predate installer assets;
	# falling back for a modern release could silently execute a stale template.
	if download_release_asset "$RELEASES_BASE_URL/$installer_tag/install.sh" "$installer_destination"; then
		return 0
	fi
	printf '%s\n' "$installer_tag" | grep -Eq '^v(0\.1\.|0\.2\.[0-5]($|-))' || return 1
	download_release_asset "$RAW_BASE_URL/$installer_tag/install.sh" "$installer_destination"
}

rollback_release() {
	previous_tag="$1"
	stage_dir="$2"
	rollback_installer="$stage_dir/rollback-install.sh"
	rollback_log="$stage_dir/rollback.log"

	valid_tag "$previous_tag" || return 1
	download_installer "$previous_tag" "$rollback_installer" || return 1
	rollback_bytes="$(wc -c < "$rollback_installer" 2>/dev/null || true)"
	case "$rollback_bytes" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$rollback_bytes" -gt 0 ] && [ "$rollback_bytes" -le "$MAX_INSTALLER_BYTES" ] || return 1
	grep -Fqx "RELEASE_TAG=\"$previous_tag\"" "$rollback_installer" || return 1
	sh -n "$rollback_installer" || return 1
	FREENETIC_RELEASE_BASE_URL="$RELEASES_BASE_URL/$previous_tag" \
		sh "$rollback_installer" >"$rollback_log" 2>&1
}

fail_update() {
	failure_dir="$1"
	failure_stage="$2"
	failure_rollback_attempted="$3"
	failure_rollback_ok="$4"
	failure_detail="$5"
	reply_update_error "$failure_stage" "$failure_rollback_attempted" \
		"$failure_rollback_ok" "$failure_detail"
	rm -rf "$failure_dir"
	exit 0
}

fail_after_mutation() {
	failure_stage="$1"
	failure_detail="$2"
	failure_rollback_attempted=0
	failure_rollback_ok=0
	failure_newline='
'

	if rollback_required "$failure_stage" && valid_tag "$previous_tag"; then
		failure_rollback_attempted=1
		if rollback_release "$previous_tag" "$stage_dir"; then
			failure_rollback_ok=1
			failure_detail="Automatic rollback to $previous_tag succeeded.${failure_newline}$failure_detail"
		else
			rollback_detail="$(tail -n 12 "$stage_dir/rollback.log" 2>/dev/null || true)"
			[ -n "$rollback_detail" ] || rollback_detail="The previous release installer could not be downloaded, verified or executed."
			failure_detail="Automatic rollback to $previous_tag failed.${failure_newline}$failure_detail${failure_newline}Rollback details:${failure_newline}$rollback_detail"
		fi
	elif rollback_required "$failure_stage"; then
		failure_detail="No previous release is recorded, so automatic rollback was not attempted.${failure_newline}$failure_detail"
	else
		failure_detail="No package changes were made by the updater.${failure_newline}$failure_detail"
	fi

	fail_update "$stage_dir" "$failure_stage" "$failure_rollback_attempted" \
		"$failure_rollback_ok" "$failure_detail"
}

installed_package_version() {
	package_name="$1"
	case "$package_manager" in
		apk)
			package_json="$(apk query --fields name,version --format json --installed \
				--from system "$package_name" 2>/dev/null || true)"
			printf '%s\n' "$package_json" | jsonfilter -e '@[0].version' 2>/dev/null || true
			;;
		opkg)
			opkg status "$package_name" 2>/dev/null | awk '$1 == "Version:" { print $2; exit }'
			;;
	esac
}

# Keep the dashboard's preflight summary aligned with the release installer.
# The installer remains the final authority; this read-only check only gives
# the user an early warning before starting a package transaction.
preflight_overlay() {
	overlay_path=/overlay
	overlay_free_kib="$(df -Pk "$overlay_path" 2>/dev/null | awk 'NR == 2 { print $4; exit }' || true)"
	if [ -z "$overlay_free_kib" ]; then
		overlay_path=/
		overlay_free_kib="$(df -Pk "$overlay_path" 2>/dev/null | awk 'NR == 2 { print $4; exit }' || true)"
	fi
	case "$overlay_free_kib" in
		''|*[!0-9]*) overlay_free_mib= ;;
		*) overlay_free_mib=$((overlay_free_kib / 1024)) ;;
	esac
}

preflight_resources() {
	mem_kib="$(awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
	case "$mem_kib" in
		''|*[!0-9]*) preflight_ram_mib= ;;
		*) preflight_ram_mib=$((mem_kib / 1024)) ;;
	esac
	preflight_cpu_cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || true)"
	case "$preflight_cpu_cores" in
		''|*[!0-9]*) preflight_cpu_cores= ;;
	esac
}

status() {
	package_manager=
	if command -v apk >/dev/null 2>&1; then
		package_manager=apk
	elif command -v opkg >/dev/null 2>&1; then
		package_manager=opkg
	fi

	target=
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		board_json="$(ubus call system board 2>/dev/null || true)"
		target="$(printf '%s\n' "$board_json" | jsonfilter -e '@.release.target' 2>/dev/null || true)"
	fi

	asset_suffix=
	case "$target" in
		mediatek/filogic) asset_suffix=aarch64_cortex-a53 ;;
		ramips/mt7621) asset_suffix=mipsel_24kc ;;
		x86/64) asset_suffix=x86_64 ;;
	esac
	overlay_min_mib=
	preflight_min_ram_mib=128
	preflight_min_cpu_cores=2
	case "$target" in
		mediatek/filogic) overlay_min_mib=16 ;;
		ramips/mt7621) overlay_min_mib=8 ;;
		x86/64) overlay_min_mib=32 ;;
	esac
	preflight_resources
	preflight_overlay
	preflight_ok=1
	preflight_error=
	if [ -z "$package_manager" ]; then
		preflight_ok=0
		preflight_error="Neither apk nor opkg is installed"
	elif [ -z "$asset_suffix" ]; then
		preflight_ok=0
		preflight_error="Unsupported OpenWrt target: ${target:-unknown}"
	elif [ -z "$preflight_ram_mib" ]; then
		preflight_ok=0
		preflight_error="Cannot read total RAM"
	elif [ "$preflight_ram_mib" -lt "$preflight_min_ram_mib" ]; then
		preflight_ok=0
		preflight_error="Only ${preflight_ram_mib} MiB RAM is available; minimum is ${preflight_min_ram_mib} MiB"
	elif [ -z "$preflight_cpu_cores" ]; then
		preflight_ok=0
		preflight_error="Cannot count CPU cores"
	elif [ "$preflight_cpu_cores" -lt "$preflight_min_cpu_cores" ]; then
		preflight_ok=0
		preflight_error="Only ${preflight_cpu_cores} CPU cores are available; minimum is ${preflight_min_cpu_cores}"
	elif [ -z "$overlay_free_mib" ]; then
		preflight_ok=0
		preflight_error="Cannot read free space on $overlay_path"
	elif [ -n "$overlay_min_mib" ] && [ "$overlay_free_mib" -lt "$overlay_min_mib" ]; then
		preflight_ok=0
		preflight_error="Only ${overlay_free_mib} MiB is free on $overlay_path; minimum is ${overlay_min_mib} MiB"
	fi

	installed_release=
	if command -v uci >/dev/null 2>&1; then
		installed_release="$(uci -q get freenetic.updates.installed_release 2>/dev/null || true)"
	fi

	json_init
	json_add_boolean ok 1
	json_add_string package_manager "$package_manager"
	json_add_string target "$target"
	json_add_string asset_suffix "$asset_suffix"
	json_add_boolean preflight_ok "$preflight_ok"
	json_add_string preflight_error "$preflight_error"
	json_add_string ram_mib "$preflight_ram_mib"
	json_add_string min_ram_mib "$preflight_min_ram_mib"
	json_add_string cpu_cores "$preflight_cpu_cores"
	json_add_string min_cpu_cores "$preflight_min_cpu_cores"
	json_add_string overlay_path "$overlay_path"
	json_add_string overlay_free_mib "$overlay_free_mib"
	json_add_string overlay_min_mib "$overlay_min_mib"
	json_add_string installed_release "$installed_release"
	json_add_array packages
	for package_name in luci-theme-freenetic luci-app-freenetic; do
		package_version="$(installed_package_version "$package_name")"
		[ -n "$package_version" ] || continue
		json_add_object ""
		json_add_string name "$package_name"
		json_add_string version "$package_version"
		json_close_object
	done
	json_close_array
	if [ -n "$package_manager" ] && [ -n "$asset_suffix" ]; then
		json_add_boolean can_update 1
	else
		json_add_boolean can_update 0
		if [ -z "$package_manager" ]; then
			json_add_string error "Neither apk nor opkg is installed"
		else
			json_add_string error "Unsupported OpenWrt target: ${target:-unknown}"
		fi
	fi
	json_dump
}

run_update() {
	tag="$1"
	stage_dir="$2"
	case "$stage_dir" in
		/tmp/freenetic-self-update.??????) ;;
		*) reply_error "Invalid update staging directory"; exit 0 ;;
	esac

	installer="$stage_dir/install.sh"
	log="$stage_dir/install.log"
	previous_tag=
	if command -v uci >/dev/null 2>&1; then
		previous_tag="$(uci -q get freenetic.updates.installed_release 2>/dev/null || true)"
	fi

	if ! command -v wget >/dev/null 2>&1; then
		fail_update "$stage_dir" download 0 0 "wget is not installed"
	fi
	if ! download_installer "$tag" "$installer"; then
		fail_update "$stage_dir" download 0 0 "Cannot download the pinned release installer"
	fi

	installer_bytes="$(wc -c < "$installer" 2>/dev/null || true)"
	case "$installer_bytes" in
		''|*[!0-9]*) installer_bytes=0 ;;
	esac
	if [ "$installer_bytes" -le 0 ] || [ "$installer_bytes" -gt "$MAX_INSTALLER_BYTES" ]; then
		fail_update "$stage_dir" manifest 0 0 "The release installer has an invalid size"
	fi
	if ! grep -Fqx "RELEASE_TAG=\"$tag\"" "$installer"; then
		fail_update "$stage_dir" manifest 0 0 "The release installer does not match the selected tag"
	fi
	if ! sh -n "$installer"; then
		fail_update "$stage_dir" manifest 0 0 "The release installer has invalid shell syntax"
	fi

	# Serialize with the stock LuCI package manager. The lock descriptor is
	# inherited by install.sh and remains held through all package operations.
	if command -v flock >/dev/null 2>&1; then
		exec 200>/tmp/ipkg.lock
		if ! flock -x 200; then
			fail_update "$stage_dir" lock 0 0 "Cannot acquire the package manager lock"
		fi
	fi

	if ! FREENETIC_RELEASE_BASE_URL="$RELEASES_BASE_URL/$tag" sh "$installer" >"$log" 2>&1; then
		detail="$(tail -n 12 "$log" 2>/dev/null || true)"
		[ -n "$detail" ] || detail="The release installer failed without output"
		failure_stage="$(last_installer_stage "$log")"
		fail_after_mutation "$failure_stage" "$detail"
	fi

	if command -v uci >/dev/null 2>&1; then
		if ! uci -q set freenetic.updates=freenetic ||
			! uci -q set "freenetic.updates.installed_release=$tag" ||
			! uci -q commit freenetic; then
			fail_after_mutation state_commit "The packages were installed, but the installed release could not be recorded."
		fi
	fi
	detail="$(tail -n 12 "$log" 2>/dev/null || true)"
	json_init
	json_add_boolean ok 1
	json_add_string tag "$tag"
	json_add_string previous_release "$previous_tag"
	json_add_string stage complete
	json_add_string detail "$detail"
	json_dump
	rm -rf "$stage_dir"
}

action="${1:-}"
case "$action" in
	status)
		[ "$#" -eq 1 ] || { reply_error "Usage: $0 status"; exit 0; }
		status
		;;
	install)
		[ "$#" -eq 2 ] || { reply_error "Usage: $0 install TAG"; exit 0; }
		tag="${2:-}"
		if ! valid_tag "$tag"; then
			reply_error "Invalid release tag"
			exit 0
		fi
		stage_dir="$(mktemp -d /tmp/freenetic-self-update.XXXXXX 2>/dev/null || true)"
		if [ -z "$stage_dir" ]; then
			reply_error "Cannot create the update staging directory"
			exit 0
		fi
		if ! cp "$0" "$stage_dir/runner" || ! chmod 0700 "$stage_dir/runner"; then
			reply_error "Cannot stage the update runner"
			rm -rf "$stage_dir"
			exit 0
		fi
		exec "$stage_dir/runner" run "$tag" "$stage_dir"
		;;
	run)
		[ "$#" -eq 3 ] || { reply_error "Usage: $0 run TAG STAGE_DIR"; exit 0; }
		tag="${2:-}"
		stage_dir="${3:-}"
		if ! valid_tag "$tag"; then
			reply_error "Invalid release tag"
			exit 0
		fi
		run_update "$tag" "$stage_dir"
		;;
	*)
		reply_error "Usage: $0 {status|install TAG}"
		;;
esac
