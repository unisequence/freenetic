{
	"luci-app-freenetic": {
		"description": "Grant access to Freenetic router management views: status/dashboard, network (WAN/LAN/Wi-Fi/DHCP/firewall) configuration, firmware backup and flashing",
		"read": {
			"cgi-io": [ "download" ],
			"ubus": {
				"uci": [ "get" ],
				"network.interface": [ "status", "dump" ],
				"network.device": [ "status" ],
				"network.wireless": [ "status" ],
				"iwinfo": [ "info", "assoclist", "devices", "freqlist", "phyname", "survey", "countrylist", "txpowerlist" ],
				"system": [ "board", "info" ],
				"luci": [ "getBuiltinEthernetPorts", "getConntrackList" ],
				"luci-rpc": [ "getDHCPLeases" ],
				"luci.wireguard": [ "getWgInstances" ],
				"wireguard": [ "status" ],
				"luci.amneziawg": [ "getWgInstances" ],
				"luci.ddns": [ "get_ddns_state", "get_services_status" ],
				"file": [ "read", "exec", "stat" ]
			},
			"file": {
				"/proc/net/arp": [ "read" ],
				"/proc/stat": [ "read" ],
				"/proc/sys/net/netfilter/nf_conntrack_count": [ "read" ],
				"/proc/sys/net/netfilter/nf_conntrack_max": [ "read" ],
				"/proc/mtd": [ "read" ],
				"/dev/mtdblock[0-9]*": [ "read" ],
				"/tmp/freenetic-startup-config.tar.gz": [ "read" ],
				"/usr/libexec/package-manager-call list-installed": [ "exec" ],
				"/usr/libexec/freenetic-package-status *": [ "exec" ],
				"/usr/libexec/freenetic-awg-feed status": [ "exec" ],
				"/usr/libexec/freenetic-ipsec-status": [ "exec" ],
				"/etc/openvpn/freenetic/*": [ "read" ],
				"/usr/share/ddns/default": [ "list" ],
				"/usr/share/ddns/default/*": [ "read" ],
				"/usr/share/ddns/custom": [ "list" ],
				"/usr/share/ddns/custom/*": [ "read" ],
				"/usr/share/ddns/list": [ "read" ]
			},
			"uci": [ "network", "wireless", "dhcp", "firewall", "ddns", "attendedsysupgrade", "luci", "freenetic", "pbr", "ipsec" ]
		},
		"write": {
			"cgi-io": [ "upload" ],
			"ubus": {
				"uci": [ "set", "commit" ],
				"network": [ "reload" ],
				"luci.wireguard": [ "generateKeyPair", "getPublicAndPrivateKeyFromPrivate", "generatePsk" ],
				"luci.amneziawg": [ "generateKeyPair", "getPublicAndPrivateKeyFromPrivate", "generatePsk" ],
				"wireguard": [ "genkey", "genpsk", "pubkey" ],
				"file": [ "exec", "write", "remove" ],
				"system": [ "validate_firmware_image" ]
			},
			"file": {
				"/tmp/freenetic-openvpn-*": [ "write" ],
				"/sbin/ifup": [ "exec" ],
				"/sbin/sysupgrade --test /tmp/firmware.bin": [ "exec" ],
				"/sbin/sysupgrade /tmp/firmware.bin": [ "exec" ],
				"/tmp/firmware.bin": [ "write" ],
				"/usr/libexec/freenetic-backup-call": [ "exec" ],
				"/usr/libexec/freenetic-diagnostics-call ping *": [ "exec" ],
				"/usr/libexec/freenetic-diagnostics-call traceroute *": [ "exec" ],
				"/usr/libexec/package-manager-call install *": [ "exec" ],
				"/usr/libexec/package-manager-call remove *": [ "exec" ],
				"/usr/libexec/freenetic-awg-feed install": [ "exec" ],
				"/usr/libexec/freenetic-openvpn-profile install *": [ "exec" ],
				"/usr/libexec/freenetic-openvpn-profile remove *": [ "exec" ],
				"/usr/libexec/freenetic-network-restart": [ "exec" ],
				"/usr/libexec/freenetic-ipsec-restart": [ "exec" ],
				"/usr/libexec/freenetic-pbr-restart": [ "exec" ],
				"/usr/lib/ddns/dynamic_dns_lucihelper.sh": [ "exec" ]
			},
			"uci": [ "network", "wireless", "dhcp", "firewall", "ddns", "luci", "freenetic", "pbr", "ipsec" ]
		}
	}
}
