msgstr "Выйти"

msgid "Switch interface style?"
msgstr "Сменить стиль интерфейса?"

#, javascript-format
msgid "This replaces the Freenetic interface with %s for everyone using this router's web UI, not just this browser. You can switch back the same way from the new interface's own system settings page."
msgstr "Это заменит интерфейс Freenetic на %s для всех пользователей веб-интерфейса роутера, а не только в этом браузере. Вернуться обратно можно через системные настройки нового интерфейса."

msgid "This changes the interface style for everyone using this router's web UI, not just this browser."
msgstr "Это изменит стиль интерфейса для всех пользователей веб-интерфейса роутера, а не только в этом браузере."

msgid "Cancel"
msgstr "Отмена"

msgid "Switch"
msgstr "Переключить"

msgid "Expand menu"
msgstr "Развернуть меню"

msgid "Collapse menu"
msgstr "Свернуть меню"

msgid "Close menu"
msgstr "Закрыть меню"

msgid "Close"
msgstr "Закрыть"

msgid "Discard unsaved changes and leave this page?"
msgstr "Отменить несохранённые изменения и покинуть страницу?"

#, javascript-format
msgid "Failed to save language: %s"
msgstr "Не удалось сохранить язык: %s"

msgid "Loading view…"
msgstr "Загрузка страницы…"

msgid "Unknown error"
msgstr "Неизвестная ошибка"

msgid "Unable to load this page"
msgstr "Не удалось загрузить эту страницу"

