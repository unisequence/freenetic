# Theme shell and settings
msgid "auto"
msgstr "авто"

msgid "Settings"
msgstr "Настройки"

msgid "Automatic"
msgstr "Автоматически"

msgid "Light"
msgstr "Светлая"

msgid "Dark"
msgstr "Тёмная"

msgid "Command Line"
msgstr "Командная строка"

