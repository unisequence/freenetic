{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const model = replace(boardinfo.model ?? boardinfo.hostname ?? '?', / \(.*\)$/, '');
	const brand = `FREENETIC ${model}`;

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			(function() {
				var STORE_KEY = 'freenetic-theme'; // 'light' | 'dark' | absent -> follow system
				var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
				var root = document.querySelector(':root');

				function apply() {
					var override = null;
					try { override = localStorage.getItem(STORE_KEY); } catch (e) {}
					var dark = override ? (override === 'dark') : mediaQuery.matches;
					root.setAttribute('data-darkmode', dark);
				}

				window.freeneticSetTheme = function(mode) {
					try {
						if (mode === 'auto') localStorage.removeItem(STORE_KEY);
						else localStorage.setItem(STORE_KEY, mode);
					} catch (e) {}
					apply();
				};

				mediaQuery.addEventListener('change', apply);
				apply();
			})();
		</script>
		<script>
			(function() {
				try {
					if (localStorage.getItem('freenetic-password-toast-dismissed') === '1')
						document.documentElement.classList.add('fn-password-toast-dismissed');
				} catch (e) {}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="icon" type="image/svg+xml" href="{{ media }}/favicon.svg">
		<link rel="shortcut icon" href="{{ media }}/favicon.svg">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<!-- Start every authenticated page with both optional navigation drawers
		     closed.  The controls can still be opened manually after the shell
		     has loaded, but the first paint should not be a wall of navigation. -->
		<div id="fn-shell" class="fn-sidebar-collapsed">
			<header id="fn-topbar">
				<a class="fn-brand" href="/" title="{{ striptags(brand) }}">
					<span class="fn-brand-name">FREENETIC</span>
					<span class="fn-brand-model">{{ striptags(model) }}</span>
				</a>
				<div class="fn-topbar-right">
					<div id="indicators"></div>
					<div id="fn-settings"></div>
				</div>
			</header>

			<div id="fn-scroll">
			<div id="fn-body">
				<nav id="fn-sidebar">
					<ul id="sidebar-menu"></ul>
					<button id="fn-sidebar-toggle" type="button" aria-label="{{ _('Expand menu') }}">
						<svg viewBox="0 0 24 24" width="18" height="18"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
					</button>
				</nav>
				<button id="fn-sidebar-backdrop" type="button" aria-label="{{ _('Close menu') }}" aria-hidden="true"></button>

				<div id="fn-main">
					<div id="tabmenu"></div>

					<main id="maincontent" class="container" tabindex="-1">
						<h1 id="fn-page-title" class="fn-sr-only">{{ dispatched?.title ? _(dispatched.title) : 'Freenetic' }}</h1>
						{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
							<div class="alert-message warning fn-toast" id="fn-password-toast">
								<button type="button" class="fn-toast-close" aria-label="{{ _('Close') }}" onclick="var t=this.closest('.fn-toast');t.classList.add('fn-toast-closing');setTimeout(function(){ t.remove(); }, 180)">
									<svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
								</button>
								<h4>{{ _('No password set!') }}</h4>
								<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
								<div class="fn-toast-actions">
									{% if (dispatcher.lookup("admin/system/admin")): %}
									  <a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a>
									{% endif %}
									<button type="button" class="btn fn-toast-dismiss">{{ _("Don't ask again") }}</button>
								</div>
							</div>
							<script>
								(function() {
									var toast = document.querySelector('#fn-password-toast');
									var dismiss = toast && toast.querySelector('.fn-toast-dismiss');
									if (!dismiss) return;

									dismiss.addEventListener('click', function() {
										try { localStorage.setItem('freenetic-password-toast-dismissed', '1'); } catch (e) {}
										toast.classList.add('fn-toast-closing');
										setTimeout(function() { toast.remove(); }, 180);
									});
								})();
							</script>
						{% endif %}

						{% if (boardinfo.rootfs_type == "initramfs"): %}
							<div class="alert-message warning">
								<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
								<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
								{% if (dispatcher.lookup("admin/system/flash")): %}
								  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						<noscript>
							<div class="alert-message warning">
								<h4>{{ _('JavaScript required!') }}</h4>
								<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
							</div>
						</noscript>
		{% endif %}
