{%
	import { glob, unlink } from 'fs';

	const boardinfo = ubus.call('system', 'board');
	const model = replace(boardinfo.model ?? boardinfo.hostname ?? '?', / \(.*\)$/, '');
	const themes = uci.get_all('luci', 'themes') || {};
	const currentinterface = uci.get('luci', 'main', 'mediaurlbase') ?? '/luci-static/freenetic';
	const wantinterface = http.formvalue('_interface');

	/* The login page is rendered before an authenticated LuCI session exists,
	   so apply the interface switch here instead of relying on the post-login
	   settings drawer.  Only paths registered in luci.themes are accepted. */
	if (wantinterface) {
		let targetinterface = null;

		for (let name, path in themes)
			if (substr(name, 0, 1) != '.' && path == wantinterface) {
				targetinterface = path;
				break;
			}

		if (targetinterface && targetinterface != currentinterface) {
			uci.set('luci', 'main', 'mediaurlbase', targetinterface);
			uci.commit('luci');

			/* The dispatcher caches menu visibility by menu-file hash, not by
			   luci.main.mediaurlbase.  Remove it before the redirected request
			   so Freenetic-only entries appear/disappear immediately. */
			for (let path in glob('/tmp/luci-indexcache*'))
				unlink(path);

			http.redirect(dispatcher.build_url('admin/status/overview'));
		}
	}

	// Same mechanism as System > Language and Style (luci.main.lang / luci.languages),
	// applied directly here since this page renders before a session exists.
	const wantlang = http.formvalue('_lang');
	if (wantlang && wantlang != uci.get('luci', 'main', 'lang')) {
		uci.set('luci', 'main', 'lang', wantlang);
		uci.commit('luci');
	}

	const langs = { auto: _('auto'), en: 'English' };
	for (let k, v in uci.get_all('luci', 'languages'))
		if (substr(k, 0, 1) != '.')
			langs[k] = v;
	const curlang = uci.get('luci', 'main', 'lang') ?? 'auto';
-%}

{% include('header', { blank_page: true }) %}

<script>
	/* A login starts a fresh shell session.  Do not carry drawer state from
	   the previous authenticated session into the next one. */
	(function() {
		try {
			localStorage.removeItem('freenetic-sidebar-expanded');
			localStorage.removeItem('freenetic-settings-open');
		} catch (e) {}
	})();
</script>

<div class="fn-login-page">
	<div class="fn-login-card">
		<div class="fn-login-card-inner">
			<button type="button" id="fn-theme-toggle" class="fn-theme-toggle" aria-label="{{ _('Switch color theme') }}">
				<svg class="fn-icon-sun" viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
				<svg class="fn-icon-moon" viewBox="0 0 24 24" width="16" height="16"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
			</button>
			<h1>{{ _('Sign in to the web configurator') }}</h1>

			<form method="post" id="fn-login-form">
				<div class="fn-field">
					<label class="fn-login-label" for="luci_username">{{ _('Username') }}</label>
					<input name="luci_username" id="luci_username" type="text" autocomplete="username"
						value="{{ entityencode(duser, true) }}">
				</div>
				<div class="fn-field fn-field-password">
					<label class="fn-login-label" for="luci_password">{{ _('Password') }}</label>
					<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
					<button type="button" class="fn-eye-toggle" aria-label="{{ _('Show password') }}" aria-pressed="false">
						<svg viewBox="0 0 24 24" width="18" height="18"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
					</button>
				</div>

				{% if (fuser): %}
				<div class="alert-message error">
					{{ _('Invalid username and/or password! Please try again.') }}
				</div>
				{% endif %}

				<button type="submit" class="fn-login-submit">{{ _('Log in') }}</button>
			</form>

			<form method="post" id="fn-lang-form">
				<div class="fn-field fn-lang-field">
					<select name="_lang" id="fn-lang-select">
						{% for (let code, label in langs): %}
						<option value="{{ code }}" {{ code == curlang ? 'selected' : '' }}>{{ label }}</option>
						{% endfor %}
					</select>
				</div>
			</form>

			<div class="fn-login-links">
				<a href="#" id="fn-cant-signin">{{ _("Can't sign in") }}</a>
				<span class="fn-login-links-sep">|</span>
				<a href="#" id="fn-support-center">{{ _('Support Center') }}</a>
			</div>
		</div>
	</div>

	<div class="fn-login-banner">
		<div class="fn-login-banner-inner fn-login-glitch">
			<span class="fn-login-glyph" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="84" height="84">
					<rect x="3" y="10" width="18" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
					<path d="M8 10V6M16 10V6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
					<circle cx="8" cy="5" r="1" fill="currentColor"/>
					<circle cx="16" cy="5" r="1" fill="currentColor"/>
					<circle cx="7" cy="14" r=".8" fill="currentColor"/>
					<circle cx="10" cy="14" r=".8" fill="currentColor"/>
					<circle cx="13" cy="14" r=".8" fill="currentColor"/>
				</svg>
			</span>
			<div class="fn-login-model">
				<span class="fn-login-model-brand">FREENETIC</span>
				<span class="fn-login-model-name">{{ striptags(model) }}</span>
			</div>
		</div>
		<a href="#" class="fn-login-more" id="fn-more-options">{{ _('Other management options') }}</a>
	</div>
</div>

<div id="fn-cant-signin-dialog" class="fn-dialog" role="dialog" aria-modal="true" aria-labelledby="fn-cant-signin-title" tabindex="-1" hidden>
	<div class="fn-dialog-box">
		<h3 id="fn-cant-signin-title">{{ _("Can't sign in?") }}</h3>
		<p>{{ sprintf(_('The default username is %s.'), '<code>root</code>') }}</p>
		<p>{{ _('If you forgot the password, press and hold the Reset button on the device for 10 seconds to restore factory defaults. This will erase your configuration.') }}</p>
		<button type="button" class="fn-dialog-close">{{ _('Close') }}</button>
	</div>
</div>

<div id="fn-interface-dialog" class="fn-dialog" role="dialog" aria-modal="true" aria-labelledby="fn-interface-title" aria-describedby="fn-interface-scope-note" tabindex="-1" hidden>
	<div class="fn-dialog-box">
		<h3 id="fn-interface-title">{{ _('Switch interface style?') }}</h3>
		<form method="post" id="fn-interface-form">
			<p id="fn-interface-scope-note" class="fn-interface-scope-note">{{ _("This changes the interface style for everyone using this router's web UI, not just this browser.") }}</p>
			<div class="fn-field fn-interface-field">
				<label class="fn-login-label" for="fn-interface-select">{{ _('Interface') }}</label>
				<select name="_interface" id="fn-interface-select">
					{% for (let name, path in themes): %}
					{% if (substr(name, 0, 1) != '.'): %}
					<option value="{{ entityencode(path, true) }}" {{ path == currentinterface ? 'selected' : '' }}>{{ entityencode(name, true) }}</option>
					{% endif %}
					{% endfor %}
				</select>
			</div>
			<div class="fn-dialog-actions">
				<button type="button" class="fn-dialog-close">{{ _('Cancel') }}</button>
				<button type="submit" class="fn-dialog-submit">{{ _('Switch') }}</button>
			</div>
		</form>
	</div>
</div>

<div id="fn-support-dialog" class="fn-dialog" role="dialog" aria-modal="true" aria-labelledby="fn-support-title" tabindex="-1" hidden>
	<div class="fn-dialog-box">
		<h3 id="fn-support-title">{{ _('Support Center') }}</h3>
		<p><a href="https://forum.openwrt.org/" target="_blank" rel="noreferrer">forum.openwrt.org</a></p>
		<p><a href="https://github.com/openwrt/openwrt" target="_blank" rel="noreferrer">github.com/openwrt/openwrt</a></p>
		<button type="button" class="fn-dialog-close">{{ _('Close') }}</button>
	</div>
</div>

<script>
	(function() {
		var toggle = document.querySelector('.fn-eye-toggle');
		var pw = document.querySelector('#luci_password');
		toggle.addEventListener('click', function() {
			var visible = pw.type === 'password';
			pw.type = visible ? 'text' : 'password';
			toggle.setAttribute('aria-pressed', visible ? 'true' : 'false');
			toggle.setAttribute('aria-label', visible ? _('Hide password') : _('Show password'));
		});
		document.querySelector('#luci_username').focus();

		document.querySelector('#fn-lang-select').addEventListener('change', function(ev) {
			ev.target.form.submit();
		});

		document.querySelector('#fn-theme-toggle').addEventListener('click', function() {
			var isDark = document.querySelector(':root').getAttribute('data-darkmode') === 'true';
			window.freeneticSetTheme(isDark ? 'light' : 'dark');
		});

		function dialogFocusable(dlg) {
			return Array.prototype.slice.call(dlg.querySelectorAll(
				'a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])'
			)).filter(function(element) {
				return !element.disabled && !element.hidden && element.getAttribute('aria-hidden') !== 'true';
			});
		}

		function trapDialogFocus(ev, dlg) {
			if (ev.key !== 'Tab')
				return;

			var focusable = dialogFocusable(dlg);
			if (!focusable.length) {
				ev.preventDefault();
				dlg.focus();
				return;
			}

			var first = focusable[0];
			var last = focusable[focusable.length - 1];
			if (ev.shiftKey && document.activeElement === first) {
				ev.preventDefault();
				last.focus();
			} else if (!ev.shiftKey && document.activeElement === last) {
				ev.preventDefault();
				first.focus();
			}
		}

		function wire(openIds, dlgId, initialSelector) {
			var dlg = document.querySelector(dlgId);
			var opener = null;
			var close = dlg.querySelector('.fn-dialog-close');
			var ids = Array.isArray(openIds) ? openIds : [openIds];

			ids.forEach(function(openId) {
				document.querySelector(openId).addEventListener('click', function(ev) {
					ev.preventDefault();
					opener = ev.currentTarget;
					dlg.hidden = false;
					window.setTimeout(function() {
						var initial = dlg.querySelector(initialSelector) || dialogFocusable(dlg)[0];
						if (initial)
							initial.focus();
					}, 0);
				});
			});

			function hide() {
				dlg.hidden = true;
				if (opener && document.contains(opener))
					opener.focus();
			}

			close.addEventListener('click', hide);
			dlg.addEventListener('click', function(ev) {
				if (ev.target === dlg) hide();
			});
			dlg.addEventListener('keydown', function(ev) {
				if (ev.key === 'Escape') {
					ev.preventDefault();
					hide();
				} else {
					trapDialogFocus(ev, dlg);
				}
			});
		}
		wire('#fn-cant-signin', '#fn-cant-signin-dialog', '.fn-dialog-close');
		wire('#fn-more-options', '#fn-interface-dialog', '#fn-interface-select');
		wire('#fn-support-center', '#fn-support-dialog', '.fn-dialog-close');
	})();
</script>

{% include('footer', { blank_page: true }) %}
